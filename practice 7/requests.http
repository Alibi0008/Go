@baseUrl = http://localhost:8080
@json = application/json

### Health check
GET {{baseUrl}}/health

### Register User A
POST {{baseUrl}}/users/
Content-Type: {{json}}

{
  "username": "user-a2",
  "email": "a2@example.com",
  "password": "secret123"
}

### Register User B
POST {{baseUrl}}/users/
Content-Type: {{json}}

{
  "username": "user-b2",
  "email": "b2@example.com",
  "password": "secret123"
}

### Login User A
# После выполнения скопируйте token в переменную ниже.
POST {{baseUrl}}/users/login
Content-Type: {{json}}

{
  "username": "user-a2",
  "password": "secret123"
}

### Login User B
# После выполнения скопируйте token в переменную ниже.
POST {{baseUrl}}/users/login
Content-Type: {{json}}

{
  "username": "user-b2",
  "password": "secret123"
}

### Login Bootstrap Admin
# Логин и пароль по умолчанию: admin / admin123
# После выполнения скопируйте token в переменную ниже.
POST {{baseUrl}}/users/login
Content-Type: {{json}}

{
  "username": "admin",
  "password": "admin123"
}

